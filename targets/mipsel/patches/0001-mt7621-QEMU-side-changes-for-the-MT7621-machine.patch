+/*
+ * Bring-up aid (MT7621_PCWATCH): keep the last 128 translated-block PCs and
+ * dump them the first time execution leaves the kernel image range, i.e. the
+ * first user-space entry or the first runaway into the heap.
+ */
+static void pcwatch_note(uint64_t pc)
+{
+    static int on = -1;
+    static int armed, done;
+    static uint64_t ring[256];
+    static unsigned idx;
+    unsigned i;
+
+    if (on < 0) {
+        on = getenv("MT7621_PCWATCH") != NULL;
+    }
+    if (!on || done || pc < 0x80000000ULL) {
+        return;
+    }
+    /* arm when the kernel's syscall dispatch runs (execve("/init") path) */
+    if (!armed) {
+        if (pc < 0x8010c200ULL || pc >= 0x8010c400ULL) {
+            return;
+        }
+        armed = 1;
+        fprintf(stderr, "pcwatch: armed at exec path pc=%08llx\n",
+                (unsigned long long)pc);
+    }
+    ring[idx & 255] = pc;
+    idx++;
+    /* dump when the boot thread goes to sleep (r4k_wait) */
+    if (pc >= 0x80107400ULL && pc < 0x80107500ULL) {
+        done = 1;
+        fprintf(stderr, "pcwatch: first sleep at pc=%08llx, last %u TBs:\n",
+                (unsigned long long)pc, idx < 256 ? idx : 256);
+        for (i = 0; i < (idx < 256 ? idx : 256); i++) {
+            unsigned k = (idx - (idx < 256 ? idx : 256) + i) & 255;
+            fprintf(stderr, "  %08llx\n", (unsigned long long)ring[k]);
+        }
+    }
+}
