diff --git a/include/exec/icache-shadow.h b/include/exec/icache-shadow.h
new file mode 100644
index 0000000..16a36f6
--- /dev/null
+++ b/include/exec/icache-shadow.h
@@ -0,0 +1,54 @@
+/*
+ * Minimal instruction-cache shadow (opt-in, MIPS).
+ *
+ * Real MIPS CPUs have separate I and D caches: a store does not change what
+ * the instruction fetch unit sees until the I-cache is invalidated.  Some
+ * guests rely on that.  In particular the MIPS compressed-kernel loader
+ * (arch/mips/boot/compressed/) is placed at its load address and is then
+ * *overwritten by its own decompression output*; it only survives because its
+ * instructions are still in the I-cache.  The kernel even admits it with a
+ * "FIXME: should we flush cache here?" comment.
+ *
+ * Plain TCG has no such separation: every instruction fetch reads the current
+ * RAM contents, so after the decompressor wrote over the loader the CPU
+ * re-translates those bytes as code and executes garbage.
+ *
+ * This provides a small page-granular shadow of instruction memory, consulted
+ * only for instruction fetch and only inside an address window chosen by the
+ * machine.  `cache`/`synci` instructions flush it, matching the architectural
+ * I-cache invalidation.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef EXEC_ICACHE_SHADOW_H
+#define EXEC_ICACHE_SHADOW_H
+
+#include "exec/vaddr.h"
+
+/*
+ * Enable the shadow for [lo, hi).  Pages are snapshot on their first
+ * instruction fetch.
+ */
+void icache_shadow_enable(uint64_t lo, uint64_t hi);
+
+/* Drop every snapshot. */
+void icache_shadow_flush(void);
+
+/*
+ * Drop the snapshot of the page containing @addr (one `cache`/`synci` line
+ * invalidate).  O(1), so a guest flushing line by line does not thrash.
+ */
+void icache_shadow_invalidate(uint64_t addr);
+
+/* Whether the shadow is enabled (used to decide whether to emit helpers). */
+bool icache_shadow_active(void);
+
+/*
+ * Instruction fetch: return the cached instruction word at @addr, snapshotting
