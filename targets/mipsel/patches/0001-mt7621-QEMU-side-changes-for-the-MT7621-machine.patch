 {
@@ -2912,7 +3016,12 @@ uint16_t cpu_ldw_code_mmu(CPUArchState *env, vaddr addr,
 uint32_t cpu_ldl_code_mmu(CPUArchState *env, vaddr addr,
                           MemOpIdx oi, uintptr_t retaddr)
 {
-    return do_ld4_mmu(env_cpu(env), addr, oi, retaddr, MMU_INST_FETCH);
+    uint32_t val = do_ld4_mmu(env_cpu(env), addr, oi, retaddr, MMU_INST_FETCH);
+
+    if (unlikely(icache_shadow_on)) {
+        val = icache_shadow_ldl(env, addr, get_mmuidx(oi), val);
+    }
+    return val;
 }
 
