+/* ------------------------------------------------------------------ */
+/* Minimal instruction-cache shadow, see exec/icache-shadow.h          */
+
+#define ICACHE_SHADOW_PAGES        1024
+#define ICACHE_SHADOW_PAGE_SIZE    4096
+#define ICACHE_SHADOW_PAGE_MASK    (ICACHE_SHADOW_PAGE_SIZE - 1)
+
+typedef struct ICacheShadowEntry {
+    uint64_t tag;
+    uint32_t gen;
+    uint8_t data[ICACHE_SHADOW_PAGE_SIZE];
+} ICacheShadowEntry;
+
+static ICacheShadowEntry *icache_shadow;
+static bool icache_shadow_on;
+static bool icache_shadow_busy;
+static uint64_t icache_shadow_lo, icache_shadow_hi;
+static uint32_t icache_shadow_gen = 1;
+
+void icache_shadow_enable(uint64_t lo, uint64_t hi)
+{
+    if (getenv("ICACHE_DEBUG")) {
+        fprintf(stderr, "icache: enabled %08llx-%08llx\n",
+                (unsigned long long)lo, (unsigned long long)hi);
+    }
+    icache_shadow_lo = lo;
+    icache_shadow_hi = hi;
+    icache_shadow_on = true;
+}
+
+bool icache_shadow_active(void)
+{
+    return icache_shadow_on;
+}
+
+void icache_shadow_flush(void)
+{
+    if (icache_shadow_on) {
+        icache_shadow_gen++;
+    }
+}
+
+void icache_shadow_invalidate(uint64_t addr)
+{
+    uint64_t page;
+    ICacheShadowEntry *e;
+
+    if (!icache_shadow_on || !icache_shadow) {
+        return;
+    }
+    page = addr & ~(uint64_t)ICACHE_SHADOW_PAGE_MASK;
+    e = &icache_shadow[(page >> 12) % ICACHE_SHADOW_PAGES];
+    if (e->tag == page + 1) {
+        e->tag = 0;
+    }
+}
+
+uint32_t icache_shadow_ldl(CPUArchState *env, vaddr addr, int mmu_idx,
+                           uint32_t fallback)
+{
+    uint64_t vaddr64 = (uint64_t)addr;
+    uint64_t page, off;
+    ICacheShadowEntry *e;
+    void *host;
+    int flags;
+
+    if (vaddr64 < icache_shadow_lo || vaddr64 >= icache_shadow_hi) {
+        return fallback;
+    }
+    off = vaddr64 & ICACHE_SHADOW_PAGE_MASK;
+    if (unlikely(off > ICACHE_SHADOW_PAGE_SIZE - 4)) {
+        return fallback;
+    }
+    page = vaddr64 & ~(uint64_t)ICACHE_SHADOW_PAGE_MASK;
+
+    if (unlikely(!icache_shadow)) {
+        icache_shadow = g_new0(ICacheShadowEntry, ICACHE_SHADOW_PAGES);
+    }
+    e = &icache_shadow[(page >> 12) % ICACHE_SHADOW_PAGES];
+
+    if (e->tag != page + 1 || e->gen != icache_shadow_gen) {
+        if (unlikely(icache_shadow_busy)) {
+            return fallback;
+        }
+        icache_shadow_busy = true;
+        flags = probe_access_flags(env, page, ICACHE_SHADOW_PAGE_SIZE,
+                                   MMU_INST_FETCH, mmu_idx, true, &host, 0);
+        icache_shadow_busy = false;
+        if ((flags & TLB_MMIO) || host == NULL) {
+            e->tag = 0;
+            return fallback;
+        }
+        memcpy(e->data, host, ICACHE_SHADOW_PAGE_SIZE);
+        e->tag = page + 1;
+        e->gen = icache_shadow_gen;
+        if (getenv("ICACHE_DEBUG")) {
+            fprintf(stderr, "icache: snapshot page %08llx gen %u\n",
+                    (unsigned long long)page, icache_shadow_gen);
+        }
+    }
+    return ldl_le_p(&e->data[off]);
+}
